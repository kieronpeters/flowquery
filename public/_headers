# Headers for the static SPA document and its assets.
#
# The Worker never sees these requests: with run_worker_first scoped to /api/*,
# page navigation is served directly by Cloudflare's asset layer. This file is
# how the document gets a Content-Security-Policy at all.
#
# Format: a URL pattern line, then indented "Name: value" lines. Comments use
# "#". Keep the policy in step with src/worker/middleware/security.ts — a test
# compares them.
/*
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
