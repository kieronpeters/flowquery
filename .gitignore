coverage/
.test-output/
playwright-report/
test-results/

# Agent tooling installed locally (skills, MCP scratch state)
.agents/

# Local database backups (never commit dumps)
backups/
*.sql.bak

# Editor and OS noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
.agent-token
