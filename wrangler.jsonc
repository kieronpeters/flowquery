{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "flowquery-db",
      // Created at M9 (2026-11-03) in APAC, per DEC-026. Local development
      // uses the same database name under .wrangler/state; this id is the
      // remote one and is only used by `wrangler deploy` and --remote commands.
      "database_id": "d4c07e7e-7f4b-4ac6-81e8-d5f46e026f6a",
      "migrations_dir": "migrations",
    },
  ],
}
